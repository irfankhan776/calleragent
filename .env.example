# ═══════════════════════════════════════════════════════════════════════
#  SMARTRECEPTION — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

# ── AI Services (required for LIVE calls) ──────────────────────────────
# Get these from the respective service dashboards
GOOGLE_API_KEY=                  # aistudio.google.com — Gemini 2.0 Flash Live
DEEPGRAM_API_KEY=                # deepgram.com — Speech-to-Text (STT)
ELEVENLABS_API_KEY=              # elevenlabs.io — Text-to-Speech (TTS)
ELEVENLABS_VOICE_ID=             # Voice ID from ElevenLabs dashboard (e.g. Rachel = "21m00Tcm4TlvDq8ikWAM")

# ── Telephony (required for LIVE calls) ────────────────────────────────
# Get these from telnyx.com/account/api-keys and the WebRTC portal
TELNYX_API_KEY=                  # Telnyx API key
TELNYX_CONNECTION_ID=            # WebRTC connection ID from Telnyx portal
TELNYX_FROM_NUMBER=              # Your Telnyx phone number e.g. +12025551234

# ── Backend (Railway auto-injects DATABASE_URL and PORT) ───────────────
# Leave DATABASE_URL blank locally — defaults to SQLite
# DATABASE_URL=postgresql://user:pass@host:5432/smartreception  # Uncomment for PostgreSQL
RECORDINGS_DIR=./recordings      # Path for call audio recordings
BACKEND_PORT=8000                # Port for FastAPI server
CORS_ORIGIN=*                    # Allow all origins (set specific URL in production)

# ── Agent Worker (set in Railway → Agent → Variables) ──────────────────
# The URL of your deployed backend — REQUIRED for the agent to post results
# Replace with your actual Railway backend URL after deployment
BACKEND_URL=http://localhost:8000
AGENT_POLL_INTERVAL=10           # Seconds between job queue polls

# ── Dashboard (set in Railway → Dashboard → Variables at BUILD time) ───
# Must be set BEFORE building the dashboard on Railway
VITE_API_BASE_URL=http://localhost:8000

# ═══════════════════════════════════════════════════════════════════════
#  SMARTRECEPTION — Environment Variables
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

# ── AI Services (required for LIVE calls) ──────────────────────────────
# Get these from the respective service dashboards
GOOGLE_API_KEY=                  # aistudio.google.com — Gemini 2.0 Flash Live
DEEPGRAM_API_KEY=                # deepgram.com — Speech-to-Text (STT)
ELEVENLABS_API_KEY=              # elevenlabs.io — Text-to-Speech (TTS)
ELEVENLABS_VOICE_ID=             # Voice ID from ElevenLabs dashboard (e.g. Rachel = "21m00Tcm4TlvDq8ikWAM")

# ── Telephony (required for LIVE calls via TeXML) ─────────────────────
# Get these from telnyx.com — see portal.telnyx.com → Account → API Keys
TELNYX_API_KEY=                  # Telnyx API key
TELNYX_ACCOUNT_SID=              # Telnyx Account SID (found in Account settings)
TELNYX_APPLICATION_SID=          # Telnyx TeXML Application SID — CREATE in portal.telnyx.com → Voice → Applications
                                  # Create a TeXML app, set the webhook URL to: https://<AGENT_PUBLIC_URL>/answer
TELNYX_FROM_NUMBER=              # Your Telnyx phone number e.g. +12025551234

# ── Agent Server (set in Railway → Agent Service → Variables) ──────────
# PUBLIC HTTPS URL of this agent service — Telnyx uses this to reach /answer and /ws
# Format: https://your-agent-service.up.railway.app
AGENT_URL=https://your-agent-service.up.railway.app
AGENT_PORT=7860                  # Internal port the FastAPI server listens on (keep 7860)

# ── Backend (Railway auto-injects DATABASE_URL and PORT) ───────────────
RECORDINGS_DIR=./recordings      # Path for call audio recordings
BACKEND_PORT=8000                # Port for FastAPI server
CORS_ORIGIN=*                   # Allow all origins (set specific URL in production)
DATABASE_URL=                    # Leave blank locally — defaults to SQLite

# ── Agent Worker ────────────────────────────────────────────────────────
# The URL of your deployed backend — REQUIRED for the worker to post results
BACKEND_URL=http://localhost:8000
AGENT_POLL_INTERVAL=10          # Seconds between job queue polls

# ── Dashboard (set in Railway → Dashboard → Variables at BUILD time) ───
VITE_API_BASE_URL=http://localhost:8000
